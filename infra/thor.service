[Unit]
Description=Thor — segundo cerebro pessoal
Documentation=https://bolla.network
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=thor
Group=thor
WorkingDirectory=/opt/thor/repo/server
Environment=NODE_ENV=production
Environment=THOR_ROOT=/opt/thor/repo
Environment=THOR_DATA=/opt/thor/data
EnvironmentFile=/opt/thor/.env
ExecStart=/usr/local/bin/node src/index.ts
Restart=always
RestartSec=3

# Reinicia sozinho, mas desiste se estiver em laco de falha: sem isso um erro
# de configuracao vira reinicio infinito que entope o journal.
StartLimitIntervalSec=60
StartLimitBurst=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=thor

# --- Isolamento -----------------------------------------------------------
# O servico so precisa escrever em /opt/thor/data. Todo o resto do disco fica
# somente leitura para ele — inclusive o proprio codigo em /opt/thor/repo, que
# e atualizado pelo deploy e nunca pela aplicacao.
#
# Isto nao e so boa pratica: e a camada que sustenta a lista de comandos do
# executar.ts. A lista erra; o isolamento nao deixa o erro virar estrago.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
ReadWritePaths=/opt/thor/data
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target

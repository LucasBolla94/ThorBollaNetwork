{
  "expo": {
    "name": "Thor",
    "slug": "thor-bollanetwork",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "thor",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#03060b",
    "splash": {
      "backgroundColor": "#03060b",
      "resizeMode": "contain",
      "image": "./assets/icon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "network.bolla.thor",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification", "fetch", "processing"]
      }
    },
    "android": {
      "package": "network.bolla.thor",
      "permissions": ["RECEIVE_BOOT_COMPLETED", "WAKE_LOCK", "POST_NOTIFICATIONS"],
      "adaptiveIcon": {
        "backgroundColor": "#03060b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-background-task",
      [
        "expo-notifications",
        {
          "color": "#ffb347",
          "defaultChannel": "aprovacoes"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "PREENCHER_COM_EAS_INIT"
      }
    }
  }
}
